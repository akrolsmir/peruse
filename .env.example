# Replicate API for ASR models
REPLICATE_API_TOKEN=

# Claude API for post-processing
ANTHROPIC_API_KEY=

# Convex
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# HuggingFace (needed for WhisperX diarization)
HUGGINGFACE_API_KEY=

# YouTube Data API v3 key — fetches video title/description/thumbnail (Next.js server)
YOUTUBE_API_KEY=

# RapidAPI key for the YouTube audio provider — resolves YouTube audio (Convex action)
RAPIDAPI_KEY=
# Optional: override the provider host (default ytstream-download-youtube-videos.p.rapidapi.com)
RAPIDAPI_YT_HOST=
